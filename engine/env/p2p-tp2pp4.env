# Production env: TP2 x PP4 with PCIe peer-to-peer (NCCL P2P + vLLM custom all-reduce).
# Needs the P2P driver (docs/p2p.md). Layer split 22,20,20,16: with 8-bit KV the middle
# stages bind KV capacity, so one layer moves from the last stage (which also holds MTP) to the first.
VLLM_PP_LAYER_PARTITION=22,20,20,16
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=128
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_LOGGING_LEVEL=INFO
# Custom all-reduce needs legacy CUDA IPC handles: expandable segments must be off.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
HF_HUB_OFFLINE=1
NCCL_P2P_DISABLE=0
NCCL_P2P_LEVEL=SYS
NCCL_IB_DISABLE=1
NCCL_DEBUG=WARN
NCCL_PROTO=LL,LL128,Simple
# Real IPC write/read test instead of trusting cudaDeviceCanAccessPeer (which ForceP2P makes true).
VLLM_SKIP_P2P_CHECK=0
CMP_PCIE_CUSTOM_AR=1
CMP_INDEXER_PREFILL_BUF_FACTOR=4
