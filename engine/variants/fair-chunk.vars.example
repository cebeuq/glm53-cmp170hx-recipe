# EXPERIMENTAL: production + fair chunked prefill. While any request is decoding, prefill work
# is capped at CMP_FAIR_CHUNK tokens per scheduler step, so a long new prompt cannot stall the
# streams already answering. Results pending; see docs/how-it-works.md#fair-chunked-prefill.
MODEL_DIR=/path/to/models/glm53-abliterated-nvfp4e-int8r
SERVED_MODEL_NAME=glm-5.3
TP=2
PP=4
CG_MODE=FULL_AND_PIECEWISE
MAX_LEN=524288
UTIL=0.97
MAX_SEQS=8
KV_DTYPE=fp8_ds_mla
ENV_FILE=env/p2p-tp2pp4.env
EXTRA_ARGS=--reasoning-parser glm45 --tool-call-parser glm47 --enable-auto-tool-choice --speculative-config '{"method":"mtp","num_speculative_tokens":2}'
DISABLE_CAR=
COMPOSE_FILE=compose.yaml:compose.p2p.yaml:compose.kvfp8.yaml:compose.kvfp8i8.yaml:compose.pipespec.yaml
CMP_PIPESPEC=1
CMP_PIPESPEC_REFILL=0
CMP_FAIR_CHUNK=384
